{
  "name": "sbllm-optimizer",
  "displayName": "SBLLM Optimizer",
  "description": "Search-based LLM code optimization for Python and C++ (SBLLM, ICSE'25) — finds inefficient code, generates candidate optimizations, verifies each by running it, and evolves toward a faster, correct solution.",
  "version": "0.4.3",
  "author": {
    "name": "Pronob Karmoker",
    "url": "https://github.com/pronobkarmoker"
  },
  "contributors": [
    "Pronob Karmoker <https://github.com/pronobkarmoker> (IIT, University of Dhaka)"
  ],
  "publisher": "sbllm-optimizer-dev",
  "private": true,
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pronobkarmoker/sbllm-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/pronobkarmoker/sbllm-optimizer/issues"
  },
  "homepage": "https://github.com/pronobkarmoker/sbllm-optimizer#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "c++",
    "code smell",
    "code speedup",
    "cpp",
    "gemini",
    "llm",
    "ollama",
    "openai",
    "optimization",
    "performance",
    "profiling",
    "python",
    "refactoring",
    "search-based",
    "static analysis"
  ],
  "galleryBanner": {
    "color": "#0F141E",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:cpp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Static analysis and the insights panel work in any workspace. Running your code (and AI-generated variants of it) to measure performance requires a trusted workspace. Interpreter, compiler, pattern-file and endpoint settings from an untrusted workspace are ignored.",
      "restrictedConfigurations": [
        "sbllmOptimizer.pythonPath",
        "sbllmOptimizer.cppCompiler",
        "sbllmOptimizer.patternFile",
        "sbllmOptimizer.ollamaHost",
        "sbllmOptimizer.openaiBaseUrl"
      ]
    }
  },
  "main": "./dist/extension.cjs",
  "type": "module",
  "contributes": {
    "commands": [
      {
        "command": "sbllmOptimizer.optimizeSelection",
        "title": "Optimize Selected Code",
        "category": "SBLLM",
        "icon": "$(zap)"
      },
      {
        "command": "sbllmOptimizer.optimizeFunction",
        "title": "Optimize Function",
        "category": "SBLLM"
      },
      {
        "command": "sbllmOptimizer.analyzeFile",
        "title": "Analyze File for Performance Issues",
        "category": "SBLLM",
        "icon": "$(search)"
      },
      {
        "command": "sbllmOptimizer.showHistory",
        "title": "Show Optimization History",
        "category": "SBLLM",
        "icon": "$(history)"
      },
      {
        "command": "sbllmOptimizer.compareBest",
        "title": "Compare Best Result (side by side, syntactic & semantic similarity)",
        "category": "SBLLM"
      },
      {
        "command": "sbllmOptimizer.applyBest",
        "title": "Apply Best Result",
        "category": "SBLLM"
      },
      {
        "command": "sbllmOptimizer.cancel",
        "title": "Cancel Optimization",
        "category": "SBLLM"
      },
      {
        "command": "sbllmOptimizer.setGeminiApiKey",
        "title": "Set Gemini API Key",
        "category": "SBLLM"
      },
      {
        "command": "sbllmOptimizer.setOpenAIApiKey",
        "title": "Set OpenAI API Key",
        "category": "SBLLM"
      },
      {
        "command": "sbllmOptimizer.diagnoseConnection",
        "title": "Diagnose Ollama Connection",
        "category": "SBLLM"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sbllmOptimizer.optimizeSelection",
          "when": "editorLangId == python || editorLangId == cpp",
          "group": "1_modification@90"
        },
        {
          "command": "sbllmOptimizer.analyzeFile",
          "when": "editorLangId == python || editorLangId == cpp",
          "group": "1_modification@91"
        }
      ],
      "editor/title": [
        {
          "command": "sbllmOptimizer.optimizeSelection",
          "when": "editorLangId == python || editorLangId == cpp",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "sbllmOptimizer.optimizeFunction",
          "when": "false"
        },
        {
          "command": "sbllmOptimizer.optimizeSelection",
          "when": "editorLangId == python || editorLangId == cpp"
        },
        {
          "command": "sbllmOptimizer.analyzeFile",
          "when": "editorLangId == python || editorLangId == cpp"
        }
      ]
    },
    "configuration": {
      "title": "SBLLM Optimizer",
      "properties": {
        "sbllmOptimizer.llmProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "gemini",
            "openai"
          ],
          "default": "ollama",
          "enumDescriptions": [
            "Local models via Ollama — free and private.",
            "Google Gemini — needs \"SBLLM: Set Gemini API Key\".",
            "OpenAI or any OpenAI-compatible server — needs \"SBLLM: Set OpenAI API Key\" (or a base URL for a local server)."
          ],
          "description": "Which LLM backend to use.",
          "order": 0
        },
        "sbllmOptimizer.ollamaHost": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of a locally running Ollama server."
        },
        "sbllmOptimizer.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Ollama model tag to use for optimization."
        },
        "sbllmOptimizer.geminiModel": {
          "type": "string",
          "default": "gemini-3.6-flash",
          "description": "Gemini model to use for optimization."
        },
        "sbllmOptimizer.maxIterations": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 6,
          "description": "Maximum evolutionary search iterations per optimize/refine run (the paper's tuned optimum is 4)."
        },
        "sbllmOptimizer.generationNumber": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Candidates sampled per generation, and the size of the initial population (the paper's generation_number = 4). Lower is faster but weakens the search."
        },
        "sbllmOptimizer.representativeSamples": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "Representative samples (Ns) shown to the model each iteration (the paper's tuned optimum is 3)."
        },
        "sbllmOptimizer.openaiModel": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "Model name for the OpenAI-compatible provider.",
          "order": 4
        },
        "sbllmOptimizer.openaiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of an OpenAI-compatible Chat Completions API (e.g. http://localhost:1234/v1 for LM Studio). Empty = the OpenAI API.",
          "order": 5
        },
        "sbllmOptimizer.minSpeedup": {
          "type": "number",
          "default": 1.1,
          "minimum": 1,
          "maximum": 10,
          "description": "Minimum speedup, verified on held-out tests, for a result to be offered as an optimization. 1.1 matches the paper's OPT metric (at least 10% faster) and keeps measurement noise from being reported as an improvement."
        },
        "sbllmOptimizer.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Python interpreter used to run and analyze code. Empty = `python` (Windows) or `python3` on PATH. Point it at your project's virtual environment so imports resolve."
        },
        "sbllmOptimizer.cppCompiler": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "C++ compiler used for benchmarking (candidates are built with -std=c++17 -O3). Empty = `g++` on PATH."
        },
        "sbllmOptimizer.patternFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional JSON/JSONL file of optimization pairs to add to the built-in pattern base — e.g. mined from the PIE training split with scripts/mine_patterns.py (the paper's own source of patterns)."
        },
        "sbllmOptimizer.analysis.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Statically analyze open Python/C++ files and flag inefficient code (nested loops, linear lookups in loops, redundant recomputation, exponential recursion, ...)."
        },
        "sbllmOptimizer.analysis.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show an \"⚡ Optimize\" CodeLens above functions with detected performance issues."
        },
        "sbllmOptimizer.analysis.codeLensForAllFunctions": {
          "type": "boolean",
          "default": false,
          "description": "Show the Optimize CodeLens above every top-level function, not just flagged ones."
        }
      }
    }
  },
  "scripts": {
    "smoke-test": "tsx src/cli/smoke-test.ts",
    "optimize": "tsx src/cli/optimize.ts",
    "typecheck": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "npm run compile && node -r ./scripts/node18-polyfill.cjs ./node_modules/@vscode/vsce/vsce package --no-dependencies",
    "publish:marketplace": "npm run compile && node -r ./scripts/node18-polyfill.cjs ./node_modules/@vscode/vsce/vsce publish --no-dependencies",
    "publish:openvsx": "npm run compile && ovsx publish --no-dependencies",
    "analyze": "tsx src/cli/analyze.ts",
    "test": "node scripts/run-tests.mjs",
    "test:vscode": "npm run compile && node test-vscode/runTest.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.24.0",
    "ovsx": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
