# Used only by the CLI tools (npm run optimize / analyze / smoke-test). The VS Code extension
# reads its settings and keys from VS Code instead.

# ollama | gemini | openai
LLM_PROVIDER=ollama

GEMINI_API_KEY=
# GEMINI_MODEL=

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible server, e.g. LM Studio:
# OPENAI_BASE_URL=http://localhost:1234/v1

OLLAMA_HOST=http://127.0.0.1:11434
# qwen2.5-coder:1.5b is fast and small (~1GB) for quick iteration.
# Swap to qwen2.5-coder:7b (~4.7GB) for noticeably better reasoning once pulled.
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Optional overrides
# PYTHON_BIN=python
# CXX=g++
# SBLLM_PATTERN_FILE=patterns-python.json
